{
  "info": {
    "name": "ClassLive API Collection",
    "description": "Run Auth > Login, copy the token into the collection variable 'token'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "classId",
      "value": "",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "quizId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Teacher",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Teacher\",\n  \"email\": \"teacher@test.com\",\n  \"password\": \"123456\",\n  \"role\": \"teacher\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Register Student",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Student\",\n  \"email\": \"student@test.com\",\n  \"password\": \"123456\",\n  \"role\": \"student\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teacher@test.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Firebase Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"<FIREBASE_CLIENT_ID_TOKEN>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/firebase-login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "firebase-login"]
            }
          }
        },
        {
          "name": "Update FCM Token",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcmToken\": \"device_token_sample_12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/fcm-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "fcm-token"]
            }
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Classes",
      "item": [
        {
          "name": "Get All Classes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes"]
            }
          }
        },
        {
          "name": "Create Class",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Physics 101\",\n  \"description\": \"Mechanics & Thermodynamics\",\n  \"subject\": \"Physics\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/classes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes"]
            }
          }
        },
        {
          "name": "Get Class by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes/{{classId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes", "{{classId}}"]
            }
          }
        },
        {
          "name": "Update Class",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Advanced Physics 101\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/classes/{{classId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes", "{{classId}}"]
            }
          }
        },
        {
          "name": "Delete Class",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes/{{classId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes", "{{classId}}"]
            }
          }
        },
        {
          "name": "Join Class",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes/{{classId}}/join",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes", "{{classId}}", "join"]
            }
          }
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "Get All Sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions"]
            }
          }
        },
        {
          "name": "Get Sessions by Class",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions?classId={{classId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions"],
              "query": [{ "key": "classId", "value": "{{classId}}" }]
            }
          }
        },
        {
          "name": "Create Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"class\": \"{{classId}}\",\n  \"title\": \"Kinematics Lecture\",\n  \"scheduledAt\": \"2026-10-10T10:00:00.000Z\",\n  \"status\": \"scheduled\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions"]
            }
          }
        },
        {
          "name": "Get Session by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}"]
            }
          }
        },
        {
          "name": "Update Session",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"live\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}"]
            }
          }
        },
        {
          "name": "Delete Session",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Quizzes",
      "item": [
        {
          "name": "Get All Quizzes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/quizzes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes"]
            }
          }
        },
        {
          "name": "Get Quizzes by Class",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/quizzes?classId={{classId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes"],
              "query": [{ "key": "classId", "value": "{{classId}}" }]
            }
          }
        },
        {
          "name": "Create Quiz",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Newtonian Mechanics Quiz\",\n  \"class\": \"{{classId}}\",\n  \"questions\": [\n    {\n      \"questionText\": \"What is the SI unit of force?\",\n      \"options\": [\"Joule\", \"Newton\", \"Watt\", \"Pascal\"],\n      \"correctAnswer\": 1\n    },\n    {\n      \"questionText\": \"What is g on Earth?\",\n      \"options\": [\"9.8 m/s²\", \"8.9 m/s²\", \"10.8 m/s²\"],\n      \"correctAnswer\": 0\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/quizzes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes"]
            }
          }
        },
        {
          "name": "Get Quiz by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/quizzes/{{quizId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes", "{{quizId}}"]
            }
          }
        },
        {
          "name": "Update Quiz",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Mechanics Quiz\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/quizzes/{{quizId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes", "{{quizId}}"]
            }
          }
        },
        {
          "name": "Delete Quiz",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/quizzes/{{quizId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes", "{{quizId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Submissions",
      "item": [
        {
          "name": "Submit Quiz Answers",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quizId\": \"{{quizId}}\",\n  \"answers\": [1, 0]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/submissions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "submissions"]
            }
          }
        },
        {
          "name": "Get All Submissions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/submissions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "submissions"]
            }
          }
        },
        {
          "name": "Get Submissions by Quiz",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/submissions?quizId={{quizId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "submissions"],
              "query": [{ "key": "quizId", "value": "{{quizId}}" }]
            }
          }
        },
        {
          "name": "Get Student Submissions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/submissions/student/{{studentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "submissions", "student", "{{studentId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Mark Own Attendance (Student)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/attendance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance"]
            }
          }
        },
        {
          "name": "Mark Student Attendance (Teacher)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"studentId\": \"{{studentId}}\",\n  \"status\": \"present\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/attendance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance"]
            }
          }
        },
        {
          "name": "Get All Attendance Records",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance"]
            }
          }
        },
        {
          "name": "Get Attendance by Session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance?sessionId={{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance"],
              "query": [{ "key": "sessionId", "value": "{{sessionId}}" }]
            }
          }
        },
        {
          "name": "Get Student Attendance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance/student/{{studentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance", "student", "{{studentId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Send Class Notification",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"classId\": \"{{classId}}\",\n  \"title\": \"Class Schedule Update\",\n  \"body\": \"Quiz starts in 15 minutes!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notifications/send",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "send"]
            }
          }
        }
      ]
    }
  ]
}
